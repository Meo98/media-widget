<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Seit Android 11 sieht eine App fremde Apps nur, wenn sie es anmeldet.
         Wir brauchen Icon, Name und Start-Intent der Media-Apps sowie deren
         Media-Dienst und Medientasten-Empfänger für den Wiederstart. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON"/>
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigureActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- Reine Ansicht ohne Eingaben; exportiert, damit sie sich zum Prüfen per adb öffnen lässt. -->
        <activity
            android:name=".SizeGalleryActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"/>

        <activity
            android:name=".ThemeEditorActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"/>

        <!-- Türöffner für MediaSessionManager.getActiveSessions(). Ohne
             aktiven NotificationListener verweigert das System Zugriff
             auf fremde Media-Sessions, selbst wenn wir den Listener gar
             nicht für Notifications nutzen. -->
        <service
            android:name=".NotifListener"
            android:label="@string/listener_label"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- Widget-Provider: reagiert auf System-Lebenszyklus (Enabled,
             Update, Deleted) und auf unsere internen Klick-Actions. -->
        <receiver
            android:name=".MediaWidgetProvider"
            android:label="@string/widget_bar_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.meo.mediawidget.ACTION_PLAY_PAUSE"/>
                <action android:name="com.meo.mediawidget.ACTION_NEXT"/>
                <action android:name="com.meo.mediawidget.ACTION_PREV"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_widget_info"/>
        </receiver>

        <receiver
            android:name=".MediaWidgetCardProvider"
            android:label="@string/widget_card_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_widget_card_info"/>
        </receiver>

        <receiver
            android:name=".MediaWidgetLargeProvider"
            android:label="@string/widget_large_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_widget_large_info"/>
        </receiver>

    </application>
</manifest>
